# Public Supabase client config. These values may be used by the browser.
# RLS must be enabled; never use service_role in frontend code.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Required for the stable single-owner /api/state mode in Vercel.
# Never expose these values in frontend code.
SUPABASE_SERVICE_ROLE_KEY=
BORJAI_OWNER_ID=

# Server-only AI providers. Keep all provider keys server-side only.
GROQ_API_KEY=
GROQ_VISION_MODEL=
GROQ_COACH_MODEL=
OPENAI_API_KEY=
OPENAI_COACH_MODEL=
OPENAI_JUDGE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_COACH_MODEL=
ANTHROPIC_JUDGE_MODEL=
GEMINI_API_KEY=
GEMINI_COACH_MODEL=
